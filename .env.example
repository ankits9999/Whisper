# Port for the LiveCaptions Node.js server
PORT=3000

# URL of the Python ASR microservice
# Default works when both processes run on the same machine
ASR_URL=ws://localhost:8765

# Energy VAD thresholds (Int16 RMS scale, 0–32767).
# Raise SPEECH_RMS_THRESHOLD if background noise triggers false captions.
# Lower it if speech is not being detected.
# SPEECH_RMS_THRESHOLD=500
# SILENCE_RMS_THRESHOLD=250
