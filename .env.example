# Copy this file to .env and fill in your provider API keys.
# You only need the key for the provider(s) you intend to use.

# ElevenLabs Scribe Realtime v2 (default — streaming, partials)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Sarvam AI Speech-to-Text (Indic languages — segment-based)
SARVAM_API_KEY=your_sarvam_key_here

PORT=3000
